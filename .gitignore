.venv/
__pycache__/
*.pyc
.env
db.sqlite3
/media/
/staticfiles/
*.log
.DS_Store

# Binario del CLI de Tailwind (~110MB, se descarga aparte, no se versiona)
/tools/

# Secretos y certificados de producción
/deploy/.env
/deploy/certs/*.pem
/deploy/meshcentral/config.json

# Agente de prueba: artefactos de build de PyInstaller e identidad de la estación
# de prueba (no tiene sentido versionar un token/hardware_id de una máquina puntual).
# agente_prueba.spec SÍ se versiona (a partir del 10-ago-2026 dejó de ser un archivo
# autogenerado descartable: define a mano los dos ejecutables — consola y servicio — y
# los hiddenimports de pywin32 que necesita el segundo; build.ps1 ya no lo regenera
# desde cero, lo usa tal cual con `pyinstaller agente_prueba.spec`).
/agente-prueba/build/
/agente-prueba/dist/
/agente-prueba/identidad.json

# deploy/docs/prueba-agente: prueba real contra producción del agente .NET.
# instalar-agente.ps1, desplegar-agente-gpo.ps1, README.md, Instalar.bat y
# config.ejemplo.txt SÍ se versionan (documentación/scripts sin secretos). Lo
# de abajo no: certs (mismo criterio que deploy/certs/*.pem), identidad real
# de la estación de prueba, config.txt con secretos reales en texto plano
# (MqttPassword/ComandoHmacSecret), y el publish self-contained del agente
# .NET (binarios de ~76MB cada uno — no pertenece al historial de este repo).
/deploy/docs/cert.pem
/deploy/docs/prueba-agente/cert.pem
/deploy/docs/prueba-agente/agente_prueba.exe
/deploy/docs/prueba-agente/identidad.json
/deploy/docs/prueba-agente/paquete-instalacion/cert.pem
/deploy/docs/prueba-agente/paquete-instalacion/config.txt
/deploy/docs/prueba-agente/paquete-instalacion/Saidsoft.Agente.exe
/deploy/docs/prueba-agente/paquete-instalacion/agente/
