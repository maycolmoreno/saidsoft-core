.venv/
__pycache__/
*.pyc
.env
db.sqlite3
/media/
/staticfiles/
*.log
.DS_Store

# Binario del CLI de Tailwind (~110MB, se descarga aparte, no se versiona)
/tools/

# Secretos y certificados de producción
/deploy/.env

# Datos reales de RRHH/operaciones (PII: cédulas, teléfonos, direcciones de sucursales
# y colaboradores de CRESIO) usados para importar apps.catalogo.Farmacia/apps.activos.
# Colaborador -- nunca al historial de git, sin importar dónde se los deje dentro del
# repo (22-ago-2026).
/docs/*.xlsx
/docs/*.xls
/docs/*.csv
/deploy/certs/*.pem
/deploy/meshcentral/config.json

# Agente de prueba: artefactos de build de PyInstaller e identidad de la estación
# de prueba (no tiene sentido versionar un token/hardware_id de una máquina puntual).
# agente_prueba.spec SÍ se versiona (a partir del 10-ago-2026 dejó de ser un archivo
# autogenerado descartable: define a mano los dos ejecutables — consola y servicio — y
# los hiddenimports de pywin32 que necesita el segundo; build.ps1 ya no lo regenera
# desde cero, lo usa tal cual con `pyinstaller agente_prueba.spec`).
/agente-prueba/build/
/agente-prueba/dist/
/agente-prueba/identidad.json

# Paquete "un clic" (Instalar.bat + config.ejemplo.txt SÍ se versionan, sin secretos).
# config.txt no: mismos secretos en texto plano que config.txt del agente .NET más
# abajo (MqttPassword/ComandoHmacSecret). cert.pem tampoco: es el CA de EMQX del
# servidor, mismo criterio que /deploy/certs/*.pem.
/agente-prueba/config.txt
/agente-prueba/cert.pem

# El script que genera `manage.py generar_script_instalacion` lleva la
# MQTT_PASSWORD_AGENTE escrita adentro. Se le entrega a cada técnico por un canal
# privado y se borra al terminar: no entra al repo ni a /media/, que se sirve sin
# autenticación. Acá por si alguien lo deja caer en el árbol por costumbre.
/Instalar-Saidsoft.ps1
/deploy/Instalar-Saidsoft.ps1

# Bases SQLite descartables de pruebas locales (demo-local.sqlite3, test-smoke.sqlite3...).
# db.sqlite3 ya estaba arriba; esto cubre las que se crean al probar con otro nombre.
*.sqlite3

# Contrasenas generadas por crear_tecnicos_soporte: nunca se versionan.
credenciales_tecnicos.txt
