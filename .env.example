# Copiar a .env y completar. Nunca versionar el .env real.

DJANGO_SETTINGS_MODULE=config.settings.desarrollo
SECRET_KEY=cambia-esto-por-una-clave-larga-y-aleatoria
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Sin definir = SQLite local. En producción usar algo como:
# DATABASE_URL=postgres://saidsoft_django:PASSWORD@localhost:5432/bd_saidsoft

MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_USE_TLS=False

# API Key administrativa de EMQX (opcional en desarrollo) — si se deja vacía, el
# aprovisionamiento de credenciales MQTT por estación queda desactivado sin romper el
# enrolamiento (ver apps.mqtt_worker.emqx_admin).
EMQX_API_URL=
EMQX_API_KEY=
EMQX_API_SECRET=

# Secreto compartido con el agente (saidsoft-agente) para firmar/verificar
# el canal de comandos MQTT (HMAC-SHA256). Debe coincidir en ambos lados.
COMANDO_HMAC_SECRET=cambia-esto-por-un-secreto-compartido-con-el-agente

# Clave de cifrado (Fernet) para la clave de recuperación de BitLocker en reposo.
# Generar con: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
BITLOCKER_ENCRYPTION_KEY=cambia-esto-por-una-clave-fernet-generada

ARCHIVOS_BASE_URL=http://localhost:8000
DESPLIEGUE_UMBRAL_ERROR_PCT_DEFAULT=10.0

# Acceso remoto interactivo (MeshCentral autoalojado). Dejar MESHCENTRAL_MESH_ID vacío
# hasta tener una instancia de MeshCentral corriendo y haber creado el device group
# (ver sección "Acceso remoto (MeshCentral)" en el README).
MESHCENTRAL_SERVER_URL=https://localhost:443
MESHCENTRAL_MESH_ID=
MESHCENTRAL_AGENT_ARCH_ID=4
MESHCENTRAL_INSTALL_FLAGS=2
MESHCENTRAL_VIEWMODE_ESCRITORIO=11
MESHCENTRAL_VIEWMODE_TERMINAL=12

# Cuenta de MeshCentral (dedicada, de bajo privilegio) para el WebSocket de control que
# usa apps.monitoreo.adapters.meshcentral (cruce MQTT×MeshCentral, run_meshcentral_worker).
# Vacío = ese worker no arranca, sin afectar el resto del stack.
MESHCENTRAL_API_WS_URL=
MESHCENTRAL_API_USUARIO=
MESHCENTRAL_API_PASSWORD=
# MeshCentral autogenera su propio certificado autofirmado por instancia — sin uno de
# estos dos, la conexión falla siempre con CERTIFICATE_VERIFY_FAILED (confirmado contra
# un servidor real). MESHCENTRAL_API_CA_CERT (ruta al cert real, preferido) o, si no se
# extrajo todavía, MESHCENTRAL_API_VERIFICAR_TLS=False como salida rápida para pruebas.
MESHCENTRAL_API_CA_CERT=
MESHCENTRAL_API_VERIFICAR_TLS=True

# Bot de Telegram para las notificaciones salientes (alertas y resumen de enlaces).
# El token lo entrega @BotFather al crear el bot; es un secreto compartido por todos los
# canales, por eso vive acá y no en CanalNotificacion (ahí va el chat_id, que no es
# secreto). El chat_id de cada destino se carga como CanalNotificacion tipo "telegram",
# por unidad de negocio o global, igual que el webhook de Teams.
# Vacío = Telegram desactivado; el correo y el webhook siguen funcionando igual.
TELEGRAM_BOT_TOKEN=

# Chat que recibe el resumen agrupado de enlaces caídos/recuperados. Separado de los
# canales de alertas a propósito: el volumen de enlaces es otro orden de magnitud (196
# caídas en 24 h sobre 700 sitios), y quien quiere las alertas no necesariamente quiere
# eso. Mismo criterio que ENLACES_NOTIFICAR_A.
# Vacío = no se manda el resumen por Telegram (el evento igual queda registrado).
ENLACES_TELEGRAM_CHAT_ID=

# Diagnóstico automático de alertas CRÍTICAS con Claude (apps/monitoreo/diagnostico_ia.py).
# Se genera una sola vez por incidente y llega como mensaje de seguimiento por Telegram,
# rotulado como automático y sin verificar. Se obtiene en console.anthropic.com.
# Vacío = no se pide diagnóstico; la alerta se abre y se notifica exactamente igual.
ANTHROPIC_API_KEY=

# Chats autorizados a CONSULTARLE al bot (/enlaces, /estado, /alertas, /farmacia), en
# lista separada por comas. Un bot de Telegram es publico: cualquiera que adivine su
# usuario puede escribirle, y estas consultas devuelven codigos de farmacia, IPs de
# routers y que esta caido — el mapa que alguien necesitaria para atacar la red.
# Vacio = el bot no le responde a nadie y run_telegram_bot ni siquiera arranca.
TELEGRAM_CHAT_IDS_AUTORIZADOS=

# Minutos que un enlace tiene que llevar caído antes de avisarlo. Un corte que se
# resuelve solo en pocos minutos no amerita un aviso ni un ticket con el proveedor.
# 0 desactiva el filtro (se avisa toda caída confirmada).
ENLACES_MINUTOS_MINIMOS_AVISO=10
