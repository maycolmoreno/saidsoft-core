<?xml version="1.0" encoding="utf-8"?>
<!--
  La app habla SOLO por HTTPS (ver AppConfig.baseUrl) y confia en el certificado
  propio de SAIDSOFT desde los assets (HttpSeguro). Antes esto permitia trafico sin
  cifrar hacia las redes privadas porque la API anterior era HTTP; dejarlo abierto
  ahora solo habilitaria un ataque de degradacion a HTTP en la red de una farmacia.
-->
<network-security-config>
  <base-config cleartextTrafficPermitted="false" />
</network-security-config>
