# Este proyecto se desarrolla en Windows pero los scripts .sh corren dentro de
# contenedores Linux (ENTRYPOINT de Docker, bootstrap de EMQX, certs de dev) —
# forzar LF siempre evita el clásico "exec: /entrypoint.sh: permission denied"
# / "bad interpreter" por CRLF colado en el shebang.
*.sh text eol=lf
*.conf text eol=lf

# Las unidades de systemd corren en el servidor Linux, igual que los .sh. Un CRLF en
# `ExecStart=` deja un  pegado al ultimo argumento y el comando falla con un mensaje
# que no menciona el salto de linea — el mismo modo de falla del shebang, con otra cara.
*.service text eol=lf
*.timer text eol=lf
