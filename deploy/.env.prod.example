# Copiar a deploy/.env y completar. NUNCA versionar el .env real.
# Genera SECRET_KEY con: python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"

# --- Django ---
SECRET_KEY=cambia-esto-por-una-clave-larga-y-aleatoria
#
# Dos escenarios según tengas dominio público con TLS real o no (ver servicio `nginx`
# en docker-compose.yml, que siempre exige HTTPS con certificado autofirmado si no hay
# dominio — PLAN_MODERNIZACION.md §10-Y/SEC-2):
#
# Con dominio + TLS real (Let's Encrypt u otra CA):
#   ALLOWED_HOSTS=saidsof.tudominio.com
#   CSRF_TRUSTED_ORIGINS=https://saidsof.tudominio.com
#
# Sin dominio, solo red interna (certificado autofirmado, ej. deploy/certs/cert.pem —
# regenerarlo con la IP real vía deploy/certs/generar-certs-dev.sh IP:x.x.x.x):
#   ALLOWED_HOSTS=x.x.x.x
#   CSRF_TRUSTED_ORIGINS=https://x.x.x.x:8084
ALLOWED_HOSTS=saidsof.tudominio.com
CSRF_TRUSTED_ORIGINS=https://saidsof.tudominio.com
# URL pública desde la que los agentes descargan los paquetes (nginx sirve /media/ sin
# autenticación, ver config/urls.py — a propósito HTTP siempre, aunque el resto del
# panel exija HTTPS: no hay credenciales en este path, y así ningún agente de la flota
# necesita confiar en el certificado autofirmado del panel solo para bajar un archivo).
# Sin dominio: usar http://x.x.x.x:8080 (el puerto de nginx que solo sirve /media/ y
# redirige el resto a HTTPS).
ARCHIVOS_BASE_URL=https://saidsof.tudominio.com
# Secreto compartido con el agente (`ComandoHmacSecret` en su config.json) para
# firmar/verificar el canal de comandos MQTT. Debe coincidir EXACTO en ambos lados — si
# no coincide, el agente descarta el comando en silencio (no hay error visible).
#
# Desde el agente 0.21 esto es solo el CAMINO VIEJO: cada estación recibe su propio
# secreto en el enrolamiento y el servidor le firma con ese (ver
# VERSION_AGENTE_CON_HMAC_PROPIO). El instalador deja `ComandoHmacSecret` vacío a
# propósito; esta variable queda para los agentes anteriores a esa versión. Además firma
# los catálogos retenidos (servicios del POS y eventos de Windows). Obligatoria: sin ella
# `web` y `worker` no arrancan.
COMANDO_HMAC_SECRET=cambia-esto-por-un-secreto-compartido-con-el-agente
# Clave de cifrado (Fernet) para la clave de recuperación de BitLocker en reposo.
# Generar con: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
BITLOCKER_ENCRYPTION_KEY=cambia-esto-por-una-clave-fernet-generada

# --- PostgreSQL / TimescaleDB ---
POSTGRES_DB=bd_saidsof
POSTGRES_USER=saidsof_django
POSTGRES_PASSWORD=cambia-esta-password-de-bd

# Cifra los .sql.gz/.tar.gz que genera deploy/backup.sh (GPG, AES256 simétrico) — sin
# esto el script no corre (OPS-2, auditoría 22-ago-2026). Generar con:
#   openssl rand -base64 32
# Guardala aparte del backup (un backup cifrado con la passphrase adentro no sirve de
# nada) — ver deploy/restaurar-backup.sh para restaurar/probar un backup con esta clave.
BACKUP_ENCRYPTION_PASSPHRASE=cambia-esto-por-una-passphrase-generada-aparte

# Copia del respaldo a OneDrive con rclone ("remoto:carpeta"). Vacío = no se copia, y el
# panel muestra "Copia externa del respaldo" en advertencia. El remoto se crea una vez con
# `rclone config` como glpi: ver "Copia del respaldo a OneDrive" en README-produccion.md.
BACKUP_ONEDRIVE_REMOTO=
# Días que se conservan en OneDrive (por defecto 30).
BACKUP_ONEDRIVE_RETENCION_DIAS=30

# --- EMQX ---
EMQX_COOKIE=cambia-esta-cookie-de-cluster
EMQX_DASHBOARD_PASSWORD=cambia-esta-password-del-dashboard
# Credenciales MQTT que se siembran con bootstrap-emqx.sh y que usan panel/worker/agentes
MQTT_USERNAME_PANEL=saidsof_panel
MQTT_PASSWORD_PANEL=cambia-esta-password-panel
MQTT_USERNAME_WORKER=saidsof_worker
MQTT_PASSWORD_WORKER=cambia-esta-password-worker
MQTT_USERNAME_AGENTE=saidsof_agente
MQTT_PASSWORD_AGENTE=cambia-esta-password-agente
# MQTT_HOST/MQTT_PORT/MQTT_USE_TLS/MQTT_CA_CERT NO se leen de este .env en producción:
# deploy/docker-compose.yml los deja fijos para web/worker (host "emqx", puerto 8883,
# TLS obligatorio contra deploy/certs/cert.pem) — EMQX ahí solo expone el listener TLS,
# no hay puerto plano que dejar mal configurado por accidente. Estas 4 variables solo
# importan si corrés algo por fuera de esos contenedores contra el mismo broker (p.ej.
# `manage.py simular_agente` a mano, o `run_mqtt_worker` fuera de Docker) — sin
# MQTT_USE_TLS=True ahí, ese proceso se conecta en plano contra el puerto TLS y falla.
# SEC-6 (auditoría 22-ago-2026): antes ni siquiera estaban documentadas acá.
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_USE_TLS=False
MQTT_CA_CERT=

# API Key administrativa de EMQX (no la password del dashboard) — la usa Django
# (apps.mqtt_worker.emqx_admin) para darle a cada estación su propia credencial MQTT en
# el enrolamiento. Se generan corriendo bootstrap-emqx.sh (agrega este paso al final);
# EMQX solo muestra el secret una vez, hay que pegarlo acá en ese momento. Mientras estas
# 3 queden vacías, el aprovisionamiento por estación queda desactivado sin romper nada —
# el enrolamiento sigue funcionando solo con MQTT_USERNAME_AGENTE, como hasta ahora.
# La URL es la de la red interna de Docker, con /api/v5. NO usar localhost ni 127.0.0.1:
# dentro de un contenedor eso es el propio contenedor, no EMQX.
EMQX_API_URL=http://emqx:18083/api/v5
EMQX_API_KEY=
EMQX_API_SECRET=

# --- MeshCentral (acceso remoto interactivo, opcional) ---
# El hostname/dominio y "permitir cuentas nuevas" ya NO se configuran acá — viven en
# deploy/meshcentral/config.json (copiar desde config.json.example). Ver
# deploy/README-produccion.md, sección MeshCentral, para el proceso completo validado.
# Dejar MESHCENTRAL_MESH_ID vacío si no se va a usar acceso remoto: el resto del panel
# funciona igual, solo el botón "Instalar agente ahora" y los links de
# escritorio/terminal quedan sin efecto.
# URL pública completa (mismo host que "cert" en meshcentral/config.json, con esquema)
# que usa Django para armar los links que abre el panel.
MESHCENTRAL_SERVER_URL=https://mesh.tudominio.com
# Se llena después de crear el device group (ver README-produccion.md, paso 3).
MESHCENTRAL_MESH_ID=
MESHCENTRAL_AGENT_ARCH_ID=4
MESHCENTRAL_INSTALL_FLAGS=2
# Verificados contra una instancia real (6-ago-2026, MeshCentral v1.2.4).
MESHCENTRAL_VIEWMODE_ESCRITORIO=10
MESHCENTRAL_VIEWMODE_TERMINAL=12

# Cuenta de MeshCentral dedicada (crear una de bajo privilegio, con acceso de lectura a
# los device groups relevantes) para el WebSocket de control que usa
# apps.monitoreo.adapters.meshcentral (cruce MQTT×MeshCentral — ver PLAN_MODERNIZACION.md
# §9/§10). Vacío = el servicio meshcentral_worker no arranca, sin afectar el resto del
# stack (mismo criterio "opcional, sin romper nada" que EMQX_API_KEY).
MESHCENTRAL_API_WS_URL=wss://mesh.tudominio.com/control.ashx
MESHCENTRAL_API_USUARIO=
MESHCENTRAL_API_PASSWORD=
# MeshCentral autogenera su propio certificado autofirmado por instancia — verificado
# contra el servidor real de producción (13-ago-2026): sin uno de estos dos, la
# conexión falla siempre con CERTIFICATE_VERIFY_FAILED, incluso siendo el servidor
# legítimo. Extraer el cert real y apuntar CA_CERT a él (mismo criterio que
# MQTT_CA_CERT arriba) es lo recomendado; VERIFICAR_TLS=False es la salida rápida
# mientras tanto, pero no debería quedar así en un despliegue real.
MESHCENTRAL_API_CA_CERT=
MESHCENTRAL_API_VERIFICAR_TLS=True

# Sondeo SNMP a los Mikrotik de cada farmacia (ver apps.monitoreo.mikrotik — consumo
# de ancho de banda por sitio, PLAN_MODERNIZACION.md §9). Nada de esto se configura
# por sitio más allá de `Farmacia.ip_router` (admin de Django) — ni la community (es
# el código de la farmacia en minúscula) ni la interfaz WAN (se resuelve sola por
# SNMP, no por nombre — confirmado que no es uniforme entre sitios). Sin ninguna
# Farmacia con ip_router cargada, no hace nada.
MIKROTIK_SNMP_PUERTO=161

# ---------------------------------------------------------------------------------------
# Las variables de abajo las usa docker-compose.yml y faltaban en esta plantilla (auditoría
# de consolidación, 20-oct-2026, docs/consolidacion/INVENTARIO_TECNICO.md). Todas tienen
# un valor por defecto en config/settings: vacías, la plataforma arranca igual, pero el
# canal correspondiente queda apagado SIN avisar. Al reconstruir el servidor, revisarlas.
# ---------------------------------------------------------------------------------------

# --- HTTPS (producción) ---
# Ambas True por defecto. Ponerlas en False solo para probar sin TLS: con False el panel
# acepta HTTP plano y las cookies de sesión viajan sin cifrar.
SECURE_SSL_REDIRECT=True
COOKIES_SOLO_HTTPS=True

# --- Telegram (hoy el ÚNICO canal de avisos que funciona) ---
# Token del bot: se obtiene de @BotFather. Vacío = Telegram desactivado: no hay avisos de
# alertas, ni resumen diario, ni consultas al bot.
TELEGRAM_BOT_TOKEN=
# Chats que pueden CONSULTAR al bot (/enlaces, /estado, /alertas…), separados por coma.
# Vacío = el bot no le responde a nadie (a propósito: el bot es público).
TELEGRAM_CHAT_IDS_AUTORIZADOS=
# Chat del resumen agrupado de enlaces caídos y recuperados. Vacío = no se envía.
ENLACES_TELEGRAM_CHAT_ID=
# Chat de la mesa de ayuda. Vacío = usa ENLACES_TELEGRAM_CHAT_ID.
MESA_AYUDA_TELEGRAM_CHAT_ID=

# --- Correo (avisos de alertas y de enlaces) ---
# Vacío EMAIL_HOST_USER = no sale ningún correo (estado de producción al 28-sep-2026).
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
# A quién avisar por correo cuando un enlace se cae o vuelve, separados por coma.
# Vacío = nadie (el evento igual queda registrado).
ENLACES_NOTIFICAR_A=

# --- MFA obligatorio (S-07) ---
# False = MFA opcional, como hasta ahora. True = toda cuenta tiene que tener la verificación
# en dos pasos. MFA_PLAZO_ENROLAMIENTO (AAAA-MM-DD): hasta el fin de ese día, quien entra sin
# MFA queda obligado a configurarlo; después no entra, salvo con una ventana individual que
# abre un administrador (Admin → Perfiles de usuario → "mfa enrolar hasta"). Plazo corto:
# mientras está abierto, una contraseña robada alcanza para enrolar otro teléfono.
# Antes de encenderlo: `python manage.py estado_mfa` dice quién todavía no lo tiene.
MFA_OBLIGATORIO=False
MFA_PLAZO_ENROLAMIENTO=
# Días de vida de los tokens de la API (app móvil e integraciones). Vencido, hay que pedir
# otro; el de una cuenta de servicio lo renueva un administrador (Admin → Tokens).
API_TOKEN_DIAS=30

# --- WhatsApp con las farmacias (OPCIONAL; módulo oculto en RMM 1.0) ---
# Con WHATSAPP_MODO=apagado (el default) no se envía ni se pregunta nada, y el resto puede
# quedar vacío. Token y app secret son secretos de Meta.
WHATSAPP_MODO=apagado
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
# Solo en modo piloto: códigos de farmacia separados por coma.
WHATSAPP_FARMACIAS_PILOTO=
# Solo para pruebas: manda todo a este número en lugar de a las farmacias.
WHATSAPP_REDIRIGIR_A=
WHATSAPP_PLANTILLA_CAIDA=saidsoft_enlace_caido
WHATSAPP_PLANTILLA_ESTACION=saidsoft_caja_sin_reportar

# --- Diagnóstico con IA de alertas críticas (OPCIONAL) ---
# Vacío = no se pide diagnóstico; la alerta se abre y se avisa igual.
ANTHROPIC_API_KEY=

# --- NetFlow (OPCIONAL; piloto) ---
# Solo para routers que exportan desde una IP distinta de Farmacia.ip_router:
# "ip=CODIGO,ip=CODIGO". Vacío = se reconocen por ip_router.
NETFLOW_EXPORTADORES=
